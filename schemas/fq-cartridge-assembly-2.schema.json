{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/malaiwah/progressive-tensors/schemas/fq-cartridge-assembly-2.schema.json",
  "title": "Progressive Tensors MSRT assembly plan",
  "description": "Signed campaign plan binding an MSRT stage chain to exact base routed-expert bytes and an explicit tensor-parallel layout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "assembly", "base", "chain", "format", "runtime_profile",
    "rotation_ownership",
    "standard_lora_compatible", "runtime_operation", "codebook",
    "mcg_multiplier", "mcg_ownership", "scale_shape", "tensor_parallel",
    "shards", "stage_shards", "paths_relative_to", "bits_per_weight",
    "num_tensors", "tool_version", "created_utc", "campaign"
  ],
  "properties": {
    "schema": {"const": "fq-cartridge-assembly/2"},
    "assembly": {"$ref": "#/$defs/label"},
    "base": {"$ref": "#/$defs/base"},
    "chain": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "format": {"const": "exl3-msrt-packed"},
    "runtime_profile": {"const": "exl3-msrt-additive/1"},
    "rotation_ownership": {"const": "base"},
    "standard_lora_compatible": {"const": false},
    "runtime_operation": {
      "const": "base_exl3_gemm + sum(stage_exl3_gemm / stage_scale)"
    },
    "codebook": {"const": "mcg"},
    "mcg_multiplier": {"const": 3417055213},
    "mcg_ownership": {"const": "adapter-config"},
    "scale_shape": {"const": []},
    "tensor_parallel": {
      "const": {
        "layout": "full",
        "world_size": 1,
        "ranks": [0],
        "axis_by_projection": {
          "gate_proj": "output",
          "up_proj": "output",
          "down_proj": "input"
        }
      }
    },
    "paths_relative_to": {"const": "campaign root"},
    "bits_per_weight": {"type": "number", "exclusiveMinimum": 0},
    "shards": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativeShard"}
    },
    "stage_shards": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "label", "path", "sha256", "attestation", "layer", "block",
          "experts", "parent_label", "parent_sha256"
        ],
        "properties": {
          "label": {"$ref": "#/$defs/label"},
          "path": {"$ref": "#/$defs/relativeShard"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "attestation": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.jsonl$"
          },
          "layer": {"type": "integer", "minimum": 0, "maximum": 999},
          "block": {"type": "integer", "minimum": 0},
          "experts": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "parent_label": {"$ref": "#/$defs/label"},
          "parent_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "num_tensors": {"type": "integer", "minimum": 1},
    "tool_version": {"type": "string", "pattern": "^fq_[a-z_]+/[0-9]+$"},
    "created_utc": {"type": "string", "format": "date-time"},
    "campaign": {"$ref": "#/$defs/campaign"}
  },
  "$defs": {
    "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bits": {"type": "integer", "minimum": 1, "maximum": 6},
    "relativeShard": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.safetensors$"
    },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": [
        "label", "k", "manifest_sha256", "compatibility_sha256",
        "compatibility_by_layer"
      ],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "k": {"type": "integer", "minimum": 2, "maximum": 6},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "compatibility_sha256": {"$ref": "#/$defs/sha256"},
        "compatibility_by_layer": {"$ref": "#/$defs/compatibilityByLayer"}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "k", "parent", "experts"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "k": {"$ref": "#/$defs/bits"},
        "parent": {"$ref": "#/$defs/label"},
        "experts": {
          "oneOf": [
            {"const": "all"},
            {"type": "array", "minItems": 1, "uniqueItems": true,
             "items": {"type": "integer", "minimum": 0}}
          ]
        }
      }
    },
    "compatibilityByLayer": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "campaign": {
      "type": "object", "additionalProperties": false,
      "required": [
        "recipe_sha256", "base_model", "base_revision", "encoder_sha256",
        "signer_pubkey", "block_size", "moe_layers"
      ],
      "properties": {
        "recipe_sha256": {"$ref": "#/$defs/sha256"},
        "base_model": {"type": "string", "minLength": 1},
        "base_revision": {"type": "string", "minLength": 1},
        "encoder_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "signer_pubkey": {"$ref": "#/$defs/sha256"},
        "block_size": {"type": "integer", "minimum": 1},
        "moe_layers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
