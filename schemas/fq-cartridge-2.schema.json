{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/malaiwah/progressive-tensors/schemas/fq-cartridge-2.schema.json",
  "title": "Progressive Tensors MSRT cartridge recipe",
  "description": "A directed acyclic graph of MSRT quantization tiers for one BF16 checkpoint: complete base tiers plus rescaled residual stages that each name the parent reconstruction they correct, and the assemblies an end user can load.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bases", "stages", "moe_layers"],
  "properties": {
    "schema": {"const": "fq-cartridge/2"},
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "k"],
        "properties": {
          "label": {"$ref": "#/$defs/label"},
          "k": {"$ref": "#/$defs/bits"},
          "experts": {"const": "all"},
          "description": {"type": "string"}
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["k", "label", "parent", "experts"],
        "properties": {
          "k": {"$ref": "#/$defs/bits"},
          "label": {"$ref": "#/$defs/label"},
          "parent": {"$ref": "#/$defs/label"},
          "experts": {
            "oneOf": [
              {"const": "all"},
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 0}
              }
            ]
          },
          "description": {"type": "string"}
        }
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "base", "chain"],
        "properties": {
          "label": {"$ref": "#/$defs/label"},
          "base": {"$ref": "#/$defs/label"},
          "chain": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/label"}
          },
          "description": {"type": "string"}
        }
      }
    },
    "moe_layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 999}
    },
    "description": {"type": "string"}
  },
  "$defs": {
    "label": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
    "bits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "Trellis bitrate; the EXL3 MSRT runtime supports 1..6."
    }
  }
}
