{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/malaiwah/progressive-tensors/schemas/fq-cartridge-assembly-1.schema.json",
  "title": "Progressive Tensors MSRT assembly plan",
  "description": "Campaign-side description of one publishable MSRT product: which base checkpoint it corrects, which stage chain it applies, and exactly which campaign-relative stage shards a consumer must fetch. Consumed by fq_combine_cartridges to emit a self-contained fq-cartridge-adapter/2 adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assembly",
    "base",
    "chain",
    "format",
    "standard_lora_compatible",
    "runtime_operation",
    "codebook",
    "mcg_multiplier",
    "mcg_ownership",
    "scale_shape",
    "shards",
    "stage_shards",
    "paths_relative_to",
    "bits_per_weight",
    "num_tensors",
    "tool_version",
    "created_utc",
    "campaign"
  ],
  "properties": {
    "schema": {
      "const": "fq-cartridge-assembly/1"
    },
    "assembly": {
      "$ref": "#/$defs/label"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "k",
        "manifest_sha256"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "k": {
          "$ref": "#/$defs/bits"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "k",
          "parent",
          "experts"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "k": {
            "$ref": "#/$defs/bits"
          },
          "parent": {
            "$ref": "#/$defs/label"
          },
          "experts": {
            "$ref": "#/$defs/experts"
          }
        }
      }
    },
    "format": {
      "const": "exl3-msrt-full-rank"
    },
    "standard_lora_compatible": {
      "const": false
    },
    "runtime_operation": {
      "type": "string",
      "minLength": 1
    },
    "codebook": {
      "const": "mcg"
    },
    "mcg_multiplier": {
      "const": 3417055213
    },
    "mcg_ownership": {
      "const": "adapter-config"
    },
    "scale_shape": {
      "const": []
    },
    "paths_relative_to": {
      "const": "campaign root"
    },
    "bits_per_weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "shards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_shard"
      }
    },
    "stage_shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "path",
          "sha256",
          "attestation",
          "layer",
          "block",
          "experts",
          "parent_label",
          "parent_sha256"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "path": {
            "$ref": "#/$defs/relative_shard"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "attestation": {
            "type": "string",
            "description": "Campaign-relative path of the signed fq-attestation/1 line for this shard, so a consumer that fetches only this product still receives its provenance.",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.jsonl$"
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "block": {
            "type": "integer",
            "minimum": 0
          },
          "experts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Exactly the experts this shard carries, signed with the plan so a consumer can select shards before downloading."
          },
          "parent_label": {
            "$ref": "#/$defs/label"
          },
          "parent_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "uniqueItems": true
    },
    "num_tensors": {
      "type": "integer",
      "minimum": 0
    },
    "tool_version": {
      "type": "string",
      "pattern": "^fq_[a-z_]+/[0-9]+$"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "campaign": {
      "type": "object",
      "description": "The one campaign identity every fragment of this product must agree with: recipe, source revision, encoder build and signer.",
      "additionalProperties": false,
      "required": [
        "recipe_sha256",
        "base_model",
        "base_revision",
        "encoder_sha256",
        "signer_pubkey",
        "block_size",
        "moe_layers"
      ],
      "properties": {
        "recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_model": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "encoder_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "signer_pubkey": {
          "$ref": "#/$defs/sha256"
        },
        "block_size": {
          "type": "integer",
          "minimum": 1
        },
        "moe_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "bits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "experts": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    },
    "relative_shard": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.safetensors$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
