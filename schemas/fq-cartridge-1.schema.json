{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/malaiwah/progressive-tensors/schemas/fq-cartridge-1.schema.json",
  "title": "Progressive Tensors MSRT cartridge recipe",
  "description": "Validated MSRT base and residual-stage selection for one BF16 checkpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "base_k", "stages", "moe_layers"],
  "properties": {
    "schema": {"const": "fq-cartridge/1"},
    "base_k": {"type": "integer", "minimum": 1, "maximum": 8},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["k", "label", "experts"],
        "properties": {
          "k": {"type": "integer", "minimum": 1, "maximum": 8},
          "label": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
          "experts": {
            "oneOf": [
              {"const": "all"},
              {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 0}
              }
            ]
          },
          "description": {"type": "string"}
        }
      }
    },
    "moe_layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "description": {"type": "string"}
  }
}
