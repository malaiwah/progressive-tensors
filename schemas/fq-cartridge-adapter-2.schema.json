{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/malaiwah/progressive-tensors/schemas/fq-cartridge-adapter-2.schema.json",
  "title": "Progressive Tensors MSRT cartridge adapter",
  "description": "Runtime contract for one loadable MSRT product: the base tier it corrects and the ordered chain of full-rank rescaled trellis residuals applied on top of it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assembly",
    "base",
    "chain",
    "format",
    "standard_lora_compatible",
    "runtime_operation",
    "codebook",
    "mcg_multiplier",
    "mcg_ownership",
    "scale_shape",
    "shards",
    "num_tensors",
    "tool_version",
    "created_utc",
    "selected_experts",
    "selected_layers",
    "coverage",
    "source_assembly",
    "verified_signer",
    "campaign"
  ],
  "properties": {
    "schema": {
      "const": "fq-cartridge-adapter/2"
    },
    "assembly": {
      "$ref": "#/$defs/label"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "k",
        "manifest_sha256"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "k": {
          "$ref": "#/$defs/bits"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "k",
          "parent",
          "experts"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "k": {
            "$ref": "#/$defs/bits"
          },
          "parent": {
            "$ref": "#/$defs/label"
          },
          "experts": {
            "$ref": "#/$defs/experts"
          }
        }
      },
      "minItems": 1
    },
    "format": {
      "const": "exl3-msrt-full-rank"
    },
    "standard_lora_compatible": {
      "const": false
    },
    "runtime_operation": {
      "const": "base_exl3_gemm + sum(stage_exl3_gemm / stage_scale)"
    },
    "codebook": {
      "const": "mcg"
    },
    "mcg_multiplier": {
      "const": 3417055213
    },
    "mcg_ownership": {
      "const": "adapter-config"
    },
    "scale_shape": {
      "const": []
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_shard"
      }
    },
    "num_tensors": {
      "type": "integer",
      "minimum": 1
    },
    "selected_experts": {
      "$ref": "#/$defs/experts"
    },
    "source_assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tool_version": {
      "type": "string",
      "pattern": "^fq_[a-z_]+/[0-9]+$"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "selected_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      },
      "minItems": 1
    },
    "coverage": {
      "type": "object",
      "description": "stage label -> layer -> the exact expert ids this adapter carries for that stage. A mixed product covers different experts at different stages, so one flat list cannot state what the runtime will find.",
      "propertyNames": {
        "$ref": "#/$defs/label"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[0-9]{1,3}$"
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minProperties": 1
    },
    "verified_signer": {
      "description": "The ed25519 key whose signature was checked on the plan and on every fragment, or null when the operator combined unverified bytes on purpose.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "campaign": {
      "type": "object",
      "description": "The one campaign identity every fragment of this product must agree with: recipe, source revision, encoder build and signer.",
      "additionalProperties": false,
      "required": [
        "recipe_sha256",
        "base_model",
        "base_revision",
        "encoder_sha256",
        "signer_pubkey",
        "block_size",
        "moe_layers"
      ],
      "properties": {
        "recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_model": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "encoder_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "signer_pubkey": {
          "$ref": "#/$defs/sha256"
        },
        "block_size": {
          "type": "integer",
          "minimum": 1
        },
        "moe_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "bits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "experts": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    },
    "relative_shard": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.safetensors$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
